NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
OPPTIUM_COST_PER_CREDIT_USD=0.01
OPPTIUM_DEFAULT_RESEARCH_CREDIT_CAP=30
TAVILY_PROVIDER_CREDIT_COST_USD=0.008
NEXT_PUBLIC_OPPTIUM_INTERNAL_USAGE=false
OPENROUTER_MODEL_CAMPAIGN_PLANNING=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_PROFILE_ANALYSIS=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_COMPANY_QUALIFICATION=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_OUTREACH_GENERATION=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_CAMPAIGN_REFLECTION=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_WEBSITE_EXTRACTION=openai/gpt-5-mini
OPENROUTER_MODEL_SEARCH_RESULT_CLASSIFICATION=openai/gpt-5-mini
OPENROUTER_MODEL_GUIDED_INTERPRETATION=openai/gpt-5-mini
OPENROUTER_MODEL_LOW_RISK_TRANSFORMATION=openai/gpt-5-mini
OPENROUTER_FALLBACK_MODEL_CRITICAL=openai/gpt-5-mini
OPENROUTER_MODEL_ROUTING_ENABLED=true
OPENROUTER_MODEL_CAMPAIGN_STRATEGY_COMPILATION=google/gemini-2.5-flash
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUEST_TIMEOUT_MS=120000
# Large schema-constrained Company Intelligence stages receive a separate ceiling.
OPENROUTER_PROFILE_REQUEST_TIMEOUT_MS=240000
# Intelligence V2 is canonical for new records. These remain explicit emergency
# controls; historical V1 records stay read-only regardless of these values.
INTELLIGENCE_V2_ENABLED=true
INTELLIGENCE_V2_PROFILE_ENABLED=true
INTELLIGENCE_V2_STRATEGY_ENABLED=true
INTELLIGENCE_V2_DISCOVERY_ENABLED=true
INTELLIGENCE_V2_EVALUATION_ENABLED=true
INTELLIGENCE_V2_RANKING_ENABLED=true
INTELLIGENCE_V2_SHADOW_MODE=false
INTELLIGENCE_V2_WRITE_RESULTS=true
# Emergency kill switches for uncached V2 external calls. Set false to stop immediately.
INTELLIGENCE_V2_PROVIDER_CALLS_ENABLED=true
INTELLIGENCE_V2_MODEL_CALLS_ENABLED=true
DISCOVERY_PROVIDER_WEB_ENABLED=true
DISCOVERY_PROVIDER_PDL_ENABLED=false
DISCOVERY_PROVIDER_APOLLO_ENABLED=false
DISCOVERY_PROVIDER_CORESIGNAL_ENABLED=false
TRIGGER_SECRET_KEY=
# Only required for non-interactive CLI deployment/CI. Do not expose to the browser.
TRIGGER_ACCESS_TOKEN=
